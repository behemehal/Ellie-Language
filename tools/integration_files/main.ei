class Error {
	pri v message : string;
	pri v code : int;
	co(message, code);
}

class Result<T> {
	pri v value : ?T;
	pri v error: ?Error;
	co(value, error);

	fn unwrap() : string {
		if (self.error.is_null()) {
			ret self.value.unwrap() as string;
		} else {
			panic("Error: " + self.error.unwrap().message);
			ret "";
		}
	}

	//fn isOk() : bool {
	//	ret self.error.is_null();
	//}

	// need to enable this
	//fn isError() : bool {
	//	ret self.error.is_null() == false;
	//}

	//fn getError() : Error {
	//	ret self.error!;
	//}
}


