pub fn println(s: string);

//Ellie internal function
pub fn array_len(value: dyn): int;

pub fn frame_pos() : int;

pub fn code_pos() : int;

pub fn panic(message: string);

pub fn timestamp() : int;

pub fn render_value(value: dyn);

@ellie_deep_cast=true;
pub c true : bool = 1 as bool;
@ellie_deep_cast=false;
pub c false : bool = 0 as bool;

@dont_fix_variant;
pub class nullAble<T> {
    pri v value : T;
    co(value);

    pub fn is_null() : bool {
        ret self.value == null;
    }

    pub fn unwrap() : T {
        if self.value == null {
            panic("Error: value is null");
        }
        ret self.value;
    }
}